{
  "expo": {
    "name": "CompassCam",
    "slug": "compasscam",
    "scheme": "compasscam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.compasscam.privatecamera",
      "allowBackup": false,
      "permissions": ["CAMERA", "VIBRATE"],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#101820",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "CompassCam shows a live viewfinder only while you are using the camera screen."
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CompassCam to show a live camera preview when you choose to capture a photo.",
          "recordAudioAndroid": false
        }
      ],
      "expo-local-authentication",
      ["expo-secure-store", { "configureAndroidBackup": true }],
      "expo-sharing",
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
